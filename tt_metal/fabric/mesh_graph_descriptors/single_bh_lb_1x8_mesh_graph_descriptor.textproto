# --- Meshes ---------------------------------------------------------------
# One 1x8 mesh on a single host — single BH Loudbox exposed as a 1D ring
# (8 devices, 2 fabric channels). dim_types RING enables fabric closure
# (D7 <-> D0 is 1 hop), required by FABRIC_1D_RING ops like the MoE
# selective_reduce_combine. Mirrors the WH 1x8/1x16 torus descriptors.
mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [ 1, 8 ] dim_types: [ RING, RING ] }
  host_topology   { dims: [ 1, 1 ] }
  channels {
    count: 2
    policy: RELAXED
  }
}

# --- Instantiation --------------------------------------------------------
top_level_instance { mesh { mesh_descriptor: "M0" mesh_id: 0 } }
